    email: "hello@holdout.cc"
    website: "https://holdout.cc"
url: "https://github.com/holdout-cc/reward-hack-patterns"
repository-code: "https://github.com/holdout-cc/reward-hack-patterns"
license: MIT
version: "1.1.0"
date-released: "2026-10-25"
keywords:
  - reward hacking
  - reinforcement learning
  - RL environments
  - evaluation
  - graders
  - verifiers
